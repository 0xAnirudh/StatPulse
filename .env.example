# Copy to .env and fill in. .env is gitignored and must never be committed.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB. The docker-compose default, or an Atlas connection string.
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=statpulse

# Redis 7+. Must support EVAL and Streams: the rate limiter is a Lua
# script and the metrics buffer is a stream.
REDIS_URL=redis://localhost:6379

# Auth. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-at-least-32-characters-long
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# The origin the admin dashboard is served from, comma-separated.
# Public status reads are open to everyone; authenticated routes are not.
WEB_ORIGIN=http://localhost:5173

# How long a composed status payload is cached, and how long the
# last-known-good copy is kept to serve during a Mongo outage.
STATUS_CACHE_TTL_SEC=60
STATUS_STALE_TTL_SEC=600

# Requests a minute per client for the public status page. Everyone
# behind one NAT shares a bucket, so raise it if your readers arrive
# through a corporate proxy.
STATUS_RATE_LIMIT=120

# Monitoring.
PING_DEFAULT_INTERVAL_SEC=60
PING_CONCURRENCY=20
FLUSH_INTERVAL_MS=600000

# Allow components to point at private address space. Off by default:
# an admin-supplied URL that the server fetches is an SSRF vector into
# the VPC and the cloud metadata endpoint. Turn this on only for a
# self-hosted install that genuinely monitors internal services.
ALLOW_PRIVATE_TARGETS=false
